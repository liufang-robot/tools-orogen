# This module is used in TC_GenerationDeployment#test_periodic_data_deployment in
# test_deployment.rb.
#
# This module demonstrates automatically transferred state with periodic tasks.
name 'data'

# This consumer records fresh input images on its own periodic schedule.
task_context 'Consumer' do
    input_port 'input', 'double'
    input_port 'input2', 'int'
end

# This producer updates both output images every cycle, retaining ten as its
# final value. The consumer exits after observing this final value.
task_context 'Producer' do
    output_port 'output', 'double'
    output_port 'output2', 'int'
end

deployment "data" do
    consumer = task("consumer", 'Consumer').
        periodic(0.01).
        start
    producer = task("producer", 'Producer').
        periodic(0.1).
        start

    connect producer.output,  consumer.input, :type => :data
    connect producer.output2, consumer.input2, :type => :data
end
